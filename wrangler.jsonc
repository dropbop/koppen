{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "koppenmap",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-10",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "koppenmap.com/*",
      "zone_name": "koppenmap.com"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/data/cogs/*"]
  }
}
